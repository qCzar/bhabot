# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=123456789012345678
SERVER_ID=987654321098765432

# Database Connection (Secured with Username & Password)
# NOTE: Ensure MongoDB has authorization enabled and binds to 127.0.0.1 only.
# Format: mongodb://<username>:<password>@127.0.0.1:27017/<database_name>?authSource=admin
MONGO_URL=mongodb://sjbha_user:secure_password_here@127.0.0.1:27017/sjbha?authSource=admin

# Application Server Settings
HTTP_PORT=3000
HAPI_HOST=localhost
MEETUP_FORM_URL=https://qczar.github.io/rbhabot_expanded/
MEETUP_API_URL=http://meetup.rochesterbored.com
NODE_ENV=development

# Discord Channel IDs
CHANNEL_ADMIN=111111111111111111
CHANNEL_BOT_ADMIN=222222222222222222
CHANNEL_BOT_LOG=333333333333333333
CHANNEL_MEETUPS=444444444444444444
CHANNEL_MEETUPS_DIR=555555555555555555
CHANNEL_SHITPOST=666666666666666666
CHANNEL_THROWDOWN=777777777777777777

# Onboarding Settings
ONBOARDING_CHANNEL_ID=888888888888888888
ONBOARDING_ROLE_ID=999999999999999999
ONBOARDING_MIN_LENGTH=50

# Webhook Secrets & Permissions
REDDIT_SECRET=your_reddit_secret
PING_WHITELIST_CHANNELS=
ALLOW_EVERYONE_PING=false
COOLDOWN_USER_PING=60
COOLDOWN_ROLE_PING=7200
